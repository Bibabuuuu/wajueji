* text=auto
*.py text eol=lf
*.sh text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.csv text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.docx binary
*.npz binary
*.npy binary

# Large artifacts in the curated v4 handoff are part of the reproducible
# snapshot, but must not inflate normal Git history.
current/v4-current-mainline-2026-09-19/**/*.ndjson filter=lfs diff=lfs merge=lfs -text
current/v4-current-mainline-2026-09-19/**/*.jsonl filter=lfs diff=lfs merge=lfs -text
current/v4-current-mainline-2026-09-19/**/*.npz filter=lfs diff=lfs merge=lfs -text
current/v4-current-mainline-2026-09-19/**/*.pt filter=lfs diff=lfs merge=lfs -text
current/v4-current-mainline-2026-09-19/**/*.ppm filter=lfs diff=lfs merge=lfs -text
